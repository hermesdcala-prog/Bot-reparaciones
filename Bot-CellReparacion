# --- BASE DE DATOS ---
def init_db():
    conn = sqlite3.connect('reparaciones.db')
    cursor = conn.cursor()
    cursor.execute('''CREATE TABLE IF NOT EXISTS marcas (id INTEGER PRIMARY KEY AUTOINCREMENT, nombre TEXT UNIQUE)''')
    cursor.execute('''CREATE TABLE IF NOT EXISTS modelos (id INTEGER PRIMARY KEY AUTOINCREMENT, marca_id INTEGER, nombre TEXT)''')
    cursor.execute('''CREATE TABLE IF NOT EXISTS problemas (id INTEGER PRIMARY KEY AUTOINCREMENT, modelo_id INTEGER, titulo TEXT)''')
    cursor.execute('''CREATE TABLE IF NOT EXISTS soluciones (id INTEGER PRIMARY KEY AUTOINCREMENT, problema_id INTEGER, texto TEXT, photo_id TEXT)''')
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS valoraciones (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            solucion_id INTEGER,
            user_id INTEGER,
            sirvio INTEGER,
            UNIQUE(solucion_id, user_id)
        )
    ''')
    conn.commit()
    conn.close()

init_db()

# --- FUNCIONES AUXILIARES ---
def normalizar_marca(nombre_ingresado: str) -> str:
    coincidencias = get_close_matches(nombre_ingresado.strip().capitalize(), MARCAS_VALIDAS, n=1, cutoff=0.6)
    if coincidencias:
        return coincidencias[0]
    return nombre_ingresado.strip().capitalize()

async def borrar_mensaje_job(context: ContextTypes.DEFAULT_TYPE):
    job = context.job
    try:
        await context.bot.delete_message(chat_id=job.data["chat_id"], message_id=job.data["message_id"])
    except Exception:
        pass

async def enviar_auto_borrable(context: ContextTypes.DEFAULT_TYPE, send_coroutine, segundos: int = 3600):
    msg = await send_coroutine
    context.job_queue.run_once(
        borrar_mensaje_job,
        when=segundos,
        data={"chat_id": msg.chat_id, "message_id": msg.message_id}
    )
    return msg

