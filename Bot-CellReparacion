async def procesar_nuevo_nombre(update: Update, context: ContextTypes.DEFAULT_TYPE):
    nuevo_nombre = update.message.text.strip()
    tipo = context.user_data['edit_tipo']
    item_id = context.user_data['edit_id']

    conn = sqlite3.connect('reparaciones.db')
    cursor = conn.cursor()

    if tipo == "mar":
        nuevo_nombre = normalizar_marca(nuevo_nombre)
        cursor.execute("SELECT id FROM marcas WHERE LOWER(nombre) = LOWER(?)", (nuevo_nombre,))
        marca_existente = cursor.fetchone()

        if marca_existente:
            target_id = marca_existente[0]
            if str(target_id) != str(item_id):
                cursor.execute("UPDATE modelos SET marca_id = ? WHERE marca_id = ?", (target_id, item_id))
                cursor.execute("DELETE FROM marcas WHERE id = ?", (item_id,))
                conn.commit()
                msg = f"🔄 **Fusión Exitosa:** Todos los modelos e información se trasladaron correctamente a **{nuevo_nombre}**."
            else:
                msg = "La marca ya tenía ese nombre exacto."
        else:
            cursor.execute("UPDATE marcas SET nombre = ? WHERE id = ?", (nuevo_nombre, item_id))
            conn.commit()
            msg = f"✅ Marca corregida exitosamente a: **{nuevo_nombre}**."

    elif tipo == "mod":
        cursor.execute("UPDATE modelos SET nombre = ? WHERE id = ?", (nuevo_nombre, item_id))
        conn.commit()
        msg = f"✅ Modelo renombrado a: **{nuevo_nombre}**."

    conn.close()
    await update.message.reply_text(msg, parse_mode="Markdown")
    return ConversationHandler.END

