    cursor.execute("SELECT id, titulo FROM problemas WHERE modelo_id = ?", (modelo_id,))
    problemas = cursor.fetchall()
    conn.close()

    if not problemas:
        await query.edit_message_text("⚠️ Este modelo no posee problemas registrados.")
        return ConversationHandler.END

    keyboard = [[InlineKeyboardButton(f"⚠️ {p[1]}", callback_data=f"gestprob_{p[0]}")] for p in problemas]
    await query.edit_message_text("Selecciona la FALLA / PROBLEMA a gestionar:", reply_markup=InlineKeyboardMarkup(keyboard))
    return GEST_ACCION

async def gest_recibir_problema(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    prob_id = query.data.split("_")[1]
    context.user_data['gest_prob_id'] = prob_id

    conn = sqlite3.connect('reparaciones.db')
    cursor = conn.cursor()
    cursor.execute("SELECT id, texto, photo_id FROM soluciones WHERE problema_id = ?", (prob_id,))
    solucion = cursor.fetchone()
    conn.close()

    if not solucion:
        await query.edit_message_text("No existe solución vinculada.")
        return ConversationHandler.END

    context.user_data['gest_sol_id'] = solucion[0]

    keyboard = [
        [InlineKeyboardButton("❌ Eliminar Solución", callback_data="act_eliminar")],
        [InlineKeyboardButton("✏️ Editar Texto", callback_data="act_edit_txt")],
        [InlineKeyboardButton("🖼️ Cambiar Foto", callback_data="act_edit_img")]
    ]
    
    txt_preview = solucion[1][:150] + "..." if len(solucion[1]) > 150 else solucion[1]
    await query.edit_message_text(
        f"⚙️ **Opciones de Gestión:**\n\n**Solución actual:** {txt_preview}\n\n¿Qué deseas hacer?",
        reply_markup=InlineKeyboardMarkup(keyboard),
        parse_mode="Markdown"
    )
    return GEST_ACCION

async def gest_procesar_accion(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    accion = query.data

    sol_id = context.user_data['gest_sol_id']
    prob_id = context.user_data['gest_prob_id']

    if accion == "act_eliminar":
        conn = sqlite3.connect('reparaciones.db')
        cursor = conn.cursor()
        cursor.execute("DELETE FROM valoraciones WHERE solucion_id = ?", (sol_id,))
        cursor.execute("DELETE FROM soluciones WHERE id = ?", (sol_id,))
        cursor.execute("DELETE FROM problemas WHERE id = ?", (prob_id,))
        conn.commit()
        conn.close()

        await query.edit_message_text("🗑️ **Solución eliminada correctamente.**", parse_mode="Markdown")
        return ConversationHandler.END

    elif accion == "act_edit_txt":
        await query.edit_message_text("✍️ Escribe el **NUEVO TEXTO** de la solución:", parse_mode="Markdown")
        return GEST_EDIT_TEXTO

    elif accion == "act_edit_img":
        await query.edit_message_text("📷 Envía la **NUEVA FOTO / ESQUEMÁTICO** (o escribe `omitir` para borrar la foto actual):", parse_mode="Markdown")
        return GEST_EDIT_FOTO

async def gest_guardar_texto(update: Update, context: ContextTypes.DEFAULT_TYPE):
    nuevo_texto = update.message.text.strip()
    sol_id = context.user_data['gest_sol_id']

    conn = sqlite3.connect('reparaciones.db')
    cursor = conn.cursor()
    cursor.execute("UPDATE soluciones SET texto = ? WHERE id = ?", (nuevo_texto, sol_id))
    conn.commit()
    conn.close()

    await update.message.reply_text("✅ **Texto de la solución actualizado correctamente.**", parse_mode="Markdown")
    return ConversationHandler.END

async def gest_guardar_foto(update: Update, context: ContextTypes.DEFAULT_TYPE):
    sol_id = context.user_data['gest_sol_id']
    photo_id = update.message.photo[-1].file_id if update.message.photo else None

    conn = sqlite3.connect('reparaciones.db')
    cursor = conn.cursor()
    cursor.execute("UPDATE soluciones SET photo_id = ? WHERE id = ?", (photo_id, sol_id))
    conn.commit()
    conn.close()

    await update.message.reply_text("✅ **Imagen de la solución actualizada correctamente.**", parse_mode="Markdown")
    return ConversationHandler.END

# --- LIMPIEZA DE CHAT Y BÚSQUEDAS ---
async def limpiar_busquedas(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if update.effective_user.id not in ADMIN_IDS:
        return

    limpiados = sum(1 for u in context.application.user_data.values() if u.pop('esperando_busqueda', None))
    chat_id = update.effective_chat.id
    current_msg_id = update.message.message_id if update.message else 0

    borrados = 0
    for m_id in range(current_msg_id, max(1, current_msg_id - 100), -1):
        try:
            await context.bot.delete_message(chat_id=chat_id, message_id=m_id)
            borrados += 1
        except Exception:
            pass

    msg_conf = await context.bot.send_message(
        chat_id=chat_id,
        text=f"🧹 **Chat limpiado.**\n• Estados restablecidos: `{limpiados}`\n• Mensajes borrados: `{borrados}`",
        parse_mode="Markdown",
        reply_markup=get_main_keyboard(update.effective_user.id)
    )
    context.job_queue.run_once(borrar_mensaje_job, when=10, data={"chat_id": chat_id, "message_id": msg_conf.message_id})

async def cancelar(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await enviar_auto_borrable(context, update.message.reply_text("Proceso cancelado."))
    return ConversationHandler.END

# --- MAIN ---
def main():
    app = Application.builder().token(TOKEN).build()

    admin_conv = ConversationHandler(
        entry_points=[
            CommandHandler('agregar', agregar_start),
            MessageHandler(filters.Regex('^➕ Agregar Solución$'), agregar_start)
        ],
        states={
            MARCA: [MessageHandler(filters.TEXT & ~filters.COMMAND, recibir_marca)],
            MODELO: [MessageHandler(filters.TEXT & ~filters.COMMAND, recibir_modelo)],
            PROBLEMA: [MessageHandler(filters.TEXT & ~filters.COMMAND, recibir_problema)],
            SOLUCION_TEXTO: [MessageHandler(filters.TEXT & ~filters.COMMAND, recibir_solucion_texto)],
            SOLUCION_FOTO: [MessageHandler(filters.PHOTO | (filters.TEXT & ~filters.COMMAND), recibir_solucion_foto)],
        },
        fallbacks=[CommandHandler('cancelar', cancelar)]
    )

    edit_conv = ConversationHandler(
        entry_points=[
            MessageHandler(filters.Regex('^✏️ Editar Categoría$'), iniciar_edicion),
            CallbackQueryHandler(callback_edicion, pattern="^edit_tipo_")
        ],
        states={
            EDIT_SELECCION: [CallbackQueryHandler(recibir_seleccion_edicion, pattern="^sel_")],
            EDIT_NUEVO_NOMBRE: [MessageHandler(filters.TEXT & ~filters.COMMAND, procesar_nuevo_nombre)],
        },
        fallbacks=[CommandHandler('cancelar', cancelar)]
    )

    gest_conv = ConversationHandler(
        entry_points=[
            MessageHandler(filters.Regex('^🗑️ Gestionar / Borrar$'), gestionar_start)
        ],
        states={
            GEST_MODELO: [CallbackQueryHandler(gest_recibir_marca, pattern="^gestmar_")],
            GEST_PROB: [CallbackQueryHandler(gest_recibir_modelo, pattern="^gestmod_")],
            GEST_ACCION: [
                CallbackQueryHandler(gest_recibir_problema, pattern="^gestprob_"),
                CallbackQueryHandler(gest_procesar_accion, pattern="^act_")
            ],
            GEST_EDIT_TEXTO: [MessageHandler(filters.TEXT & ~filters.COMMAND, gest_guardar_texto)],
            GEST_EDIT_FOTO: [MessageHandler(filters.PHOTO | (filters.TEXT & ~filters.COMMAND), gest_guardar_foto)]
        },
        fallbacks=[CommandHandler('cancelar', cancelar)]
    )

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("limpiar_busquedas", limpiar_busquedas))
    app.add_handler(admin_conv)
    app.add_handler(edit_conv)
    app.add_handler(gest_conv)
    app.add_handler(CallbackQueryHandler(user_navigation))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text_buttons))

    print("Bot activo...")
    app.run_polling()

if __name__ == '__main__':
    keep_alive()  # Servidor web en segundo plano para Render
    main()
