# --- BÚSQUEDA DIRECTA DE MODELOS ---
async def ejecutar_busqueda(update: Update, context: ContextTypes.DEFAULT_TYPE, busqueda: str):
    conn = sqlite3.connect('reparaciones.db')
    cursor = conn.cursor()
    cursor.execute("""
        SELECT modelos.id, modelos.nombre, marcas.nombre
        FROM modelos JOIN marcas ON modelos.marca_id = marcas.id
        WHERE modelos.nombre LIKE ? LIMIT 10
    """, (f"%{busqueda}%",))
    resultados = cursor.fetchall()
    conn.close()

    if not resultados:
        await enviar_auto_borrable(context, update.message.reply_text(f"🔍 No se encontraron resultados para: **{busqueda}**.", parse_mode="Markdown"))
        return

    keyboard = [[InlineKeyboardButton(f"📲 {r[2]} {r[1]}", callback_data=f"modelo_{r[0]}")] for r in resultados]
    keyboard.append([InlineKeyboardButton("🏠 Menú Principal", callback_data="iniciar_menu")])
    await enviar_auto_borrable(context, update.message.reply_text(f"🔍 **Resultados para '{busqueda}':**", reply_markup=InlineKeyboardMarkup(keyboard), parse_mode="Markdown"))

